uniform float3 iResolution;
uniform float uGlow;

half4 main(float2 coord) {
    float2 p = coord / 46.0;
    float n = fbm(p);
    float n2 = fbm(p * 3.1 + float2(5.0, 2.0));
    float3 base = mix(float3(0.5, 0.15, 0.07), float3(0.9, 0.42, 0.2), n);
    base = mix(base, float3(0.93, 0.52, 0.28), smoothstep(0.6, 0.8, n2) * 0.55);
    float pit = smoothstep(0.58, 0.66, vnoise(p * 4.3));
    base *= 1.0 - 0.22 * pit;
    float strata = 0.5 + 0.5 * sin(coord.y * 0.085 + coord.x * 0.02 + n * 7.0);
    base *= 0.82 + 0.18 * strata;
    base += uGlow * float3(0.3, 0.06, 0.0) * smoothstep(0.4, 0.8, n2);
    return half4(half3(base), 1.0);
}
