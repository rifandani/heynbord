// Ice and frost over the frame: cracked cells, frost ferns and a melt line.
// uPhase loops every 4 s, so the hold of a moment is seamless.
uniform float3 iResolution;
uniform float uPhase;
uniform float uScale;
uniform float2 uOffset;
uniform float uFrost;
uniform float uCrack;
uniform float uMelt;
uniform float3 uTint;
uniform float uOpacity;

// Distance to the nearest cell edge of a Voronoi pattern.
float edge(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float d1 = 8.0;
    float d2 = 8.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float2 g = float2(float(x), float(y));
            float2 o = float2(hash(i + g), hash(i + g + float2(19.1, 7.3)));
            float d = length(g + o - f);
            if (d < d1) { d2 = d1; d1 = d; } else if (d < d2) { d2 = d; }
        }
    }
    return d2 - d1;
}

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    float2 p = (coord + uOffset) / iResolution.y * uScale;
    // Frost ferns: ridged noise that branches, thicker near the edges of the frame.
    float n = fbm(p * 3.0);
    float ridge = 1.0 - abs(2.0 * fbm(p * 6.0 + float2(n * 2.0, 1.3)) - 1.0);
    float rim = max(max(1.0 - uv.x, uv.x), max(1.0 - uv.y, uv.y));
    float reach = rim * 0.9 + n * 0.5;
    // The melt line runs from the edges inward as uMelt goes from 0 to 1.
    float alive = smoothstep(uMelt * 1.4 - 0.05, uMelt * 1.4 + 0.08, 1.45 - reach);
    float frost = smoothstep(0.55, 0.9, ridge) * smoothstep(0.2, 0.7, reach + uFrost - 0.6) * uFrost * alive;
    float haze = smoothstep(0.3, 1.0, reach) * 0.35 * uFrost * alive;
    // Cracks: the thin edges of large cells, with a glint that moves.
    float e = edge(p * 1.6);
    float crack = (1.0 - smoothstep(0.0, 0.045, e)) * uCrack;
    float glint = pow(0.5 + 0.5 * sin(6.2831853 * (uPhase + p.x * 0.3 - p.y * 0.2)), 12.0) * crack;
    float a = clamp(frost * 0.85 + haze + crack * 0.8, 0.0, 1.0) * uOpacity;
    float3 c = mix(uTint, float3(0.97, 0.99, 1.0), clamp(frost + crack * 0.7 + glint, 0.0, 1.0));
    return half4(half3(c * a), half(a));
}
