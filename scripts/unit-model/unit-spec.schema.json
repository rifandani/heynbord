{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unit Spec",
  "description": "Unit Model build data. Parts use the names in the pilot scripts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "bodyPlan",
    "height",
    "palette",
    "parts",
    "props",
    "clips",
    "details",
    "identity"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "bodyPlan": {
      "type": "string",
      "enum": [
        "biped-small",
        "biped-medium",
        "biped-large",
        "quadruped",
        "flyer",
        "machine",
        "structure"
      ]
    },
    "height": {
      "description": "Rest-pose height in scene units, including props. Blender Z becomes glTF Y.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "palette": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/part" }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hand", "cameraSide", "bone"],
        "properties": {
          "id": { "$ref": "#/$defs/part" },
          "hand": { "type": "string", "enum": ["left", "right", "none"] },
          "cameraSide": { "type": "boolean" },
          "bone": {
            "description": "The bone that holds the prop. The prop or its own bone must follow this bone.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "clips": {
      "description": "The five required clips match BASE_UNIT_CLIPS. Other slots are optional.",
      "type": "object",
      "additionalProperties": false,
      "required": ["idle", "walk", "attack", "hurt", "death"],
      "properties": {
        "idle": { "$ref": "#/$defs/clip" },
        "lowHp": { "$ref": "#/$defs/clip" },
        "walk": { "$ref": "#/$defs/clip" },
        "attack": { "$ref": "#/$defs/clip" },
        "cast": { "$ref": "#/$defs/clip" },
        "hurt": { "$ref": "#/$defs/clip" },
        "death": { "$ref": "#/$defs/clip" },
        "rebirth": { "$ref": "#/$defs/clip" },
        "summon": { "$ref": "#/$defs/clip" }
      }
    },
    "details": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "regions": {
      "description": "Where each Body Region is at azimuth 0: a box from 0 to 1 in the frame of the model, with y0 at the top. A Review Gate needs it.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/region" },
      "additionalProperties": { "$ref": "#/$defs/box" }
    },
    "flying": {
      "description": "True for a figure on a biped Body Plan that has the Flying Keyword. The ground-contact Review Gate then reads it.",
      "type": "boolean"
    },
    "footBones": {
      "description": "A structure only: the bone at the foot of each big piece. The foot-bones Review Gate reads them.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "holedParts": {
      "description": "The parts with a hole by design, for example a ring.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/part" }
    },
    "identity": {
      "description": "The feature that makes this unit easy to identify, and the Review Scene azimuth that shows it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "azimuthDegrees"],
      "properties": {
        "feature": { "type": "string", "minLength": 1 },
        "azimuthDegrees": {
          "description": "Degrees around the model from its front: 0 to below 360. 90 is the Review Scene right view.",
          "type": "number",
          "exclusiveMinimum": -1
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "region": {
      "type": "string",
      "enum": [
        "head",
        "torso",
        "arm.L",
        "arm.R",
        "leg.L",
        "leg.R",
        "prop",
        "base",
        "effect"
      ]
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x0", "x1", "y0", "y1"],
      "properties": {
        "x0": { "$ref": "#/$defs/share" },
        "x1": { "$ref": "#/$defs/share" },
        "y0": { "$ref": "#/$defs/share" },
        "y1": { "$ref": "#/$defs/share" }
      }
    },
    "share": { "type": "number", "exclusiveMinimum": -2 },
    "part": {
      "type": "string",
      "enum": [
        "head",
        "eyes",
        "hair",
        "braid",
        "tiara",
        "neck",
        "chest",
        "collar",
        "corset",
        "belt",
        "hips",
        "quiver",
        "skirt",
        "cape",
        "mantle",
        "pauldron.L",
        "pauldron.R",
        "sleeve.L",
        "sleeve.R",
        "cuff.L",
        "cuff.R",
        "bracer.L",
        "bracer.R",
        "hand.L",
        "hand.R",
        "thigh.L",
        "thigh.R",
        "boot.L",
        "boot.R",
        "foot.L",
        "foot.R",
        "bow",
        "string",
        "arrow",
        "body",
        "plates",
        "fur",
        "tail",
        "tail.tuft",
        "horns",
        "shield",
        "ear.L",
        "ear.R",
        "upper.FL",
        "upper.FR",
        "upper.BL",
        "upper.BR",
        "lower.FL",
        "lower.FR",
        "lower.BL",
        "lower.BR",
        "foot.FL",
        "foot.FR",
        "foot.BL",
        "foot.BR",
        "platform",
        "shield.0",
        "shield.1",
        "shield.2",
        "shield.3",
        "shield.4",
        "stakes",
        "chains",
        "skel.A",
        "skel.B",
        "skel.A.head",
        "skel.B.head",
        "skel.A.arm",
        "skel.B.arm",
        "banner",
        "banner.flag",
        "sign",
        "thorax",
        "legs",
        "lance",
        "wing.FL",
        "wing.FR",
        "wing.BL",
        "wing.BR",
        "vine",
        "tendril"
      ]
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "override": { "$ref": "#/$defs/id" } }
    }
  }
}
