{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    // The rules never touch the DOM (ADR-0006): no "DOM" lib here.
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": []
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
