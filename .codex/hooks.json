{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bun lint:fix",
            "timeout": 600,
            "statusMessage": "Linting the workspace"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/fallow-fix-on-stop.sh\"",
            "timeout": 600,
            "statusMessage": "Removing unused exports"
          }
        ]
      }
    ]
  }
}
