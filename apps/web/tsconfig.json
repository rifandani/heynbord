{
  "extends": "@workspace/typescript-config/react.json",
  "compilerOptions": {
    "paths": {
      "react": ["./node_modules/@types/react"],
      "@/*": ["./src/*"],
      "@test/msw": ["../../vitest.msw.ts"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client", "react"]
  },
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "include": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "**/*.json"],
  "exclude": [
    "node_modules",
    "art",
    "public",
    "dev-dist",
    "dist",
    "vite.config.*",
    "scripts/battle-build-graph.ts",
    "scripts/rules-hash.ts",
    "playwright.config.*",
    "pwa-assets.config.*"
  ]
}
