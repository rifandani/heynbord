    {
      "id": "OpeningRoad",
      "text": {
        "en-us": "You are a new Hero. Start at the Muddy Ford, and take the road back one battle at a time.",
        "id-id": "Kamu adalah Hero baru. Mulailah dari Muddy Ford, dan rebut kembali jalan itu, satu pertempuran demi satu pertempuran."
      },
      "startFrame": 1080,
      "endFrame": 1350,
