    {
      "id": "OpeningBaron",
      "text": {
        "en-us": "Now Baron Brassbelly holds those roads. His outlaws and Orc sellswords stop every cart. He pays them in gold. Where does he get it?",
        "id-id": "Kini Baron Brassbelly menguasai jalan-jalan itu. Bandit dan tentara bayaran Orc miliknya menghadang setiap kereta. Ia membayar mereka dengan emas. Dari mana emas itu?"
      },
      "startFrame": 810,
      "endFrame": 1080,
      "sceneKind": "opening",
      "momentOrder": 4,
      "clip": "opening-04.mp4",
      "poster": "opening-04.webp",
