    {
      "id": "OpeningValley",
      "text": {
        "en-us": "The first lane battle was fought in Hearthvale. Today, its roads carry bread to every town in Heynbord.",
        "id-id": "Pertempuran jalur pertama terjadi di Hearthvale. Kini, jalan-jalannya membawa roti ke setiap kota di Heynbord."
      },
      "startFrame": 540,
      "endFrame": 810,
      "sceneKind": "opening",
      "momentOrder": 3,
      "clip": "opening-03.mp4",
